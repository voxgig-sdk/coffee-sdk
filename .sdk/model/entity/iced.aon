# Entity: iced

main: kit: entity: iced: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Description of the coffee drink"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the coffee drink"
      type: "`$INTEGER`"
    }
    {
      name: "image"
      req: false
      short: "URL to an image of the coffee drink"
      type: "`$STRING`"
    }
    {
      name: "ingredients"
      req: false
      short: "List of ingredients used in the coffee drink"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      short: "Name of the coffee drink"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "iced"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/coffee/iced"
          parts: [
            "coffee"
            "iced"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
